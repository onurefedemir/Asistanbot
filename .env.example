# @BotFather'dan aldığınız token
TELEGRAM_TOKEN=
# Sadece bu Telegram kullanıcı ID'leri botu kullanabilsin (virgülle ayırın). Boş = herkes.
ALLOWED_USER_IDS=
# Kaç dakikada bir takipler kontrol edilsin
CHECK_INTERVAL_MIN=60
# Her aramada site başına en fazla kaç sayfa çekilsin
MAX_PAGES=2
# İstekler arası bekleme (saniye) - siteleri yormamak için düşürmeyin
REQUEST_DELAY=4
# httpx (varsayılan) veya playwright
FETCHER=httpx
# Fiyat bu oranda veya daha fazla düşerse bildir (0.01 = %1)
MIN_DROP_RATIO=0.01
# Beklenen fiyatın bu oranının altındaki yeni ilanlar "fırsat" sayılır (0.90 = %10 altı)
DEAL_RATIO=0.90
DB_PATH=asistanbot.db
